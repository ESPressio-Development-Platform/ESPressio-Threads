        },
        {
            "name": "ESPressio-Units",
            "version": "https://github.com/ESPressio-Development-Platform/ESPressio-Units.git#primitives_redesign"
        },
        {
            "name": "ESPressio-Timing",
            "version": "https://github.com/ESPressio-Development-Platform/ESPressio-Timing.git#primitives_redesign"
